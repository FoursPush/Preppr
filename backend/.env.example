# Preppr Backend Environment Configuration (plan.md Section 19)

# Database persistence (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/preppr
SQL_ECHO=false

# Auth & Session Management
AUTH_SECRET=your_auth_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# LLM & AI Services
LLM_API_KEY=your_llm_or_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here

# Text-To-Speech (TTS) — used by /tts/speak. Requires a real OpenAI key (sk-...).
# When no OpenAI key is set, the frontend automatically uses browser speech synthesis.
TTS_PROVIDER=openai
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Whisper Speech-To-Text (Hugging Face)
WHISPER_MODEL_NAME=openai/whisper-large-v3
WHISPER_DEVICE=auto
WHISPER_DTYPE=auto
