# Preppr Application Environment Variables

# Database Connection String (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://preppr_user:preppr_password@localhost:5432/preppr

# Authentication Secret
AUTH_SECRET=your_auth_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# LLM API Configuration (Gemini or OpenAI)
LLM_API_KEY=your_llm_api_key_here

# LiveKit WebRTC Configuration
LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
